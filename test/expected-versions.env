# What the image has to report. test/smoke.sh reads this file. A two-part
# value (15.2) accepts any patch level, a three-part value has to match in
# full. UBUNTU_DIGEST and UBUNTU_SNAPSHOT are the Dockerfile ARGs. When the
# Dockerfile bumps a version, this file changes in the same commit.

# gcc -dumpfullversion, g++ -dumpfullversion
GCC=15.2
# ld --version
BINUTILS=2.46
# ldd --version
GLIBC=2.43
# cmake --version
CMAKE=4.3.1
# ninja --version
NINJA=1.13.2
# clang -dumpversion, clang++ -dumpversion
CLANG=22.1
# pkg-config --modversion gtest
GTEST=1.17.0
# gcovr --version
GCOVR=7.2
# doxygen --version
DOXYGEN=1.15.0

# /etc/cxx-cmake-container/versions.txt, lines base-image and ubuntu-snapshot
UBUNTU_DIGEST=sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b
UBUNTU_SNAPSHOT=20260901T000000Z
